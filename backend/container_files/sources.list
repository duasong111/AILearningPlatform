# apt 源 —— 2026-07 验证 python:3.12-slim 实际跑 trixie (Debian 13)
# 验证: docker run --rm python:3.12-slim cat /etc/os-release | grep VERSION_CODENAME
# 写错 bookworm 会 404, 必须跟镜像实际版本一致.
deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie main non-free-firmware
deb https://mirrors.tuna.tsinghua.edu.cn/debian-security/ trixie-security main
deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie-updates main