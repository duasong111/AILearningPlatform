# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=aiteach
POSTGRES_USER=aiteach
POSTGRES_PASSWORD=your-password-here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Provider: mimo / minimax / openai / anthropic
LLM_PROVIDER=minimax

# MiMo (optional, if LLM_PROVIDER=mimo)
MIMO_API_KEY=your-mimo-api-key-here
MIMO_MODEL=mimo-v2.5-pro
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# MiniMax (if LLM_PROVIDER=minimax)
MINIMAX_API_KEY=your-minimax-api-key-here
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

LLM_TEMPERATURE=0.7

# OpenAI (optional, if LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (optional, if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6-20250514
ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenMAIC 视频生成服务地址（host:port，不含协议）
# 用于 iframe URL 生成、Celery 轮询 scenes 回填 outlines。请在 .env 中填入实际地址。
VIDEO_GEN_HOST=<YOUR_OPENMAIC_HOST:PORT>